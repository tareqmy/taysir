{
	"name": "taysir",
	"description": "Learn the vocabulary and grammar of Quranic Arabic through real verses.",
	"license": "GPL-3.0-only",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"data:build": "node scripts/build-corpus.ts",
		"icons": "node scripts/make-icons.ts",
		"review:export": "node scripts/export-review.ts",
		"review:apply": "node scripts/apply-review.ts",
		"hosting:check": "node scripts/check-hosting.ts",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"e2e": "playwright test",
		"e2e:install": "playwright install chromium"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"exceljs": "^4.4.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/amiri-quran": "^5.3.0",
		"idb": "^8.0.3",
		"ts-fsrs": "^5.4.2"
	}
}
